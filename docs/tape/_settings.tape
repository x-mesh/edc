# 모든 edc 데모가 공유하는 렌더 설정입니다.
# 개별 tape은 이 파일을 Source한 뒤 Width와 Height만 덮어씁니다.

Set Shell "bash"
Set FontFamily "Sarasa Mono K"
Set FontSize 16
Set Width 1200
Set Height 420
Set Padding 24
Set Margin 16
Set MarginFill "#16161e"
Set Theme "TokyoNight"
Set TypingSpeed 55ms
Set Framerate 30
Set CursorBlink false
